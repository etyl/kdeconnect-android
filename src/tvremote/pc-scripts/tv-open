"""
Brings the browser window showing a site to the front, or opens the site in a new tab of the
open browser window. Never opens a new window, unless the browser isn't running at all.

Usage: tv-open <part of the window title> <url>
Example: tv-open Netflix https://www.netflix.com/browse

On GNOME Wayland, needs the "Window Calls" extension (https://extensions.gnome.org, search
"Window Calls"): GNOME doesn't let programs list or focus other windows without it.
"""
import json
import shutil
import subprocess
import sys
import time

DEST = "org.gnome.Shell"
OBJECT_PATH = "/org/gnome/Shell/Extensions/Windows"
INTERFACE = "org.gnome.Shell.Extensions.Windows"
# How long to wait for the page to load before giving up on bringing its window to the front
FOCUS_TIMEOUT_S = 15


def call(method, *args):
    """Calls a Window Calls method and returns its (single) result."""
    result = subprocess.run(
        ["busctl", "--user", "--json=short", "call", DEST, OBJECT_PATH, INTERFACE, method, *args],
        capture_output=True, text=True, check=True, timeout=5,
    )
    return json.loads(result.stdout)["data"][0]


def window_ids():
    """Returns the ids of all windows, or None when the Window Calls extension isn't available."""
    try:
        return [window["id"] for window in json.loads(call("List"))]
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, IndexError):
        return None


def find_window(title_part):
    wanted = title_part.casefold()
    for window_id in window_ids() or []:
        try:
            if wanted in call("GetTitle", "u", str(window_id)).casefold():
                return window_id
        except (OSError, subprocess.SubprocessError, ValueError, KeyError, IndexError):
            continue  # The window closed meanwhile
    return None


def activate(window_id):
    call("Activate", "u", str(window_id))


def open_in_new_tab(url):
    browser = shutil.which("firefox") or shutil.which("firefox-esr")  # Debian ships firefox-esr
    command = [browser, "--new-tab", url] if browser else ["xdg-open", url]
    # Detached, so KDE Connect doesn't wait for the browser to exit when it was just started
    subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def main():
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    title_part, url = sys.argv[1], sys.argv[2]

    if window_ids() is None:
        print("Window Calls extension not available, can't look for an open window", file=sys.stderr)
    else:
        window_id = find_window(title_part)
        if window_id is not None:
            activate(window_id)
            return

    open_in_new_tab(url)

    if window_ids() is None:
        return
    # Firefox doesn't always raise itself on Wayland: focus its window once the page title shows up
    deadline = time.monotonic() + FOCUS_TIMEOUT_S
    while time.monotonic() < deadline:
        time.sleep(0.5)
        window_id = find_window(title_part)
        if window_id is not None:
            activate(window_id)
            return


if __name__ == "__main__":
    main()
